# Application
APP_NAME="Fake News Misinformation Detection Agent"
APP_VERSION="0.1.0"
ENVIRONMENT=local

# Default runtime mode
MODEL_MODE=transformer
INFERENCE_MODE=slm_assisted_hybrid
RUNTIME_MODE=hybrid
TOP_K_EVIDENCE=5

# Local evidence retrieval
LOCAL_FEVER_EVIDENCE_ENABLED=true
LOCAL_LIAR2_EVIDENCE_ENABLED=true

# Live/hybrid search. Keep disabled unless API keys are configured.
LIVE_SEARCH_ENABLED=false
LIVE_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
LIVE_SEARCH_MAX_RESULTS=5
LIVE_SEARCH_TIMEOUT_SECONDS=10
LIVE_SEARCH_DEPTH=basic
LIVE_SEARCH_MIN_RELEVANCE=0.55
LIVE_SEARCH_MIN_TRUST=0.60
LIVE_SEARCH_MIN_FINAL_SCORE=0.60

EXA_SEARCH_ENABLED=false
EXA_API_KEY=
EXA_SEARCH_TYPE=auto
EXA_MAX_RESULTS=5
EXA_MIN_FINAL_SCORE=0.58

# Local SLM verifier through LM Studio
# LM Studio model: qwen/qwen3.5-9b
# Important: Disable "Enable Thinking" in LM Studio inference settings.
SLM_ENABLED=true
SLM_PROVIDER=lmstudio
SLM_BASE_URL=http://hostedpath/v1
SLM_MODEL=qwen/qwen3.5-9b
SLM_TIMEOUT_SECONDS=180
SLM_TEMPERATURE=0.0
SLM_MAX_EVIDENCE_ITEMS=3
SLM_SEMANTIC_EVIDENCE_ITEMS=5
SLM_MAX_TOKENS=1200
SLM_MIN_CONFIDENCE_TO_OVERRIDE=0.60

# X/Twitter integration
# Individual public post URLs use public oEmbed and do not require a token.
# Profile/timeline analysis requires an official X API Bearer Token.
X_BEARER_TOKEN=
X_API_TIMEOUT_SECONDS=15
X_PROFILE_DEFAULT_POSTS=5
