APP_NAME=Fake News Misinformation Detection Agent
APP_VERSION=0.1.0
ENVIRONMENT=local

# -----------------------------
# Model / inference mode
# -----------------------------
MODEL_MODE=transformer
INFERENCE_MODE=slm_assisted_hybrid

# Available inference modes:
# traditional_lr
# traditional_svm
# distilbert
# distilbert_local_rag
# distilbert_hybrid
# slm_assisted_local
# slm_assisted_hybrid

# -----------------------------
# Local evidence retrieval
# -----------------------------
TOP_K_EVIDENCE=5
LOCAL_FEVER_EVIDENCE_ENABLED=true
LOCAL_LIAR2_EVIDENCE_ENABLED=true

# -----------------------------
# Runtime mode
# -----------------------------
RUNTIME_MODE=hybrid

# offline_eval = local classifier + local FEVER/LIAR2 evidence only
# hybrid       = local evidence + live web search
# degraded     = safe fallback if live search or SLM is unavailable

# -----------------------------
# Tavily live web search
# -----------------------------
LIVE_SEARCH_ENABLED=true
LIVE_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=<your key here>

LIVE_SEARCH_MAX_RESULTS=5
LIVE_SEARCH_TIMEOUT_SECONDS=10
LIVE_SEARCH_DEPTH=basic
LIVE_SEARCH_MIN_RELEVANCE=0.55
LIVE_SEARCH_MIN_TRUST=0.60
LIVE_SEARCH_MIN_FINAL_SCORE=0.60

# -----------------------------
# Exa fallback search
# -----------------------------
EXA_SEARCH_ENABLED=true
EXA_API_KEY=<Your key here>
EXA_SEARCH_TYPE=auto
EXA_MAX_RESULTS=5
EXA_MIN_FINAL_SCORE=0.58

# -----------------------------
# SLM-assisted verification
# -----------------------------
SLM_ENABLED=true
SLM_PROVIDER=lmstudio
SLM_BASE_URL=
SLM_MODEL=qwen/qwen3.5-9b

SLM_TIMEOUT_SECONDS=90
SLM_TEMPERATURE=0.0
SLM_MAX_EVIDENCE_ITEMS=3
SLM_MIN_CONFIDENCE_TO_OVERRIDE=0.60
SLM_MAX_TOKENS=1200

X_BEARER_TOKEN=